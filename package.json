{
  "name": "campus-delivery-matrix",
  "version": "1.0.0",
  "description": "Parcel Collector - gate-terminal REST API for campus parcel intake and pickup (Express + Prisma)",
  "main": "src/server.js",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
