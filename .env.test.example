# Copy this file to .env.test for `npm test`.
# Use a SEPARATE database: the tests create parcels in it.
# The database name must contain "test" or the tests refuse to run.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_delivery_matrix_test"
MONGODB_URI="mongodb://localhost:27017"
JWT_SECRET="test-secret-at-least-32-characters-long-0123456789"
NODE_ENV=test
